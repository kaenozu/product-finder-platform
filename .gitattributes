# エンコーディングと改行コードの統一。
# テキストファイルはリポジトリ内でLFに正規化する(Windowsチェックアウトでも
# 混在を防ぐ)。日本語コメントを含むファイルの文字化け混入を防ぐため、
# すべてのテキストをUTF-8で扱うこと。
* text=auto

*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.sql  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.md   text eol=lf
