{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "product-finder-platform",
  "compatibility_date": "2026-08-19",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/go/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "product-finder-platform",
      "database_id": "b00ff1c8-eb5a-49ba-ba18-446b3437f907",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
