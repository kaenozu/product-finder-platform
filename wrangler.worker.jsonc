{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "product-finder-platform",
  "compatibility_date": "2026-08-19",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/go/*"],
  },
  // KV binding (rate limit / click dedup) - 未設定だと該当APIは503でfail-closedする。
  // 作成: npx wrangler kv namespace create RATE_LIMIT -> 返却されたidを記入
  // "kv_namespaces": [
  //   { "binding": "KV", "id": "<KV_NAMESPACE_ID>" }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "product-finder-platform",
      "database_id": "b00ff1c8-eb5a-49ba-ba18-446b3437f907",
      "migrations_dir": "migrations",
    },
  ],
  // cron trigger は product-finder-platform-cron（wrangler.cron.jsonc）が単一の所有者。
  // ここで重複宣言すると日次ingestが2 Workerで二重実行されるため、意図的に持たせない。
  "observability": {
    "enabled": true,
  },
}
