{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "product-finder-platform-cron",
  "compatibility_date": "2026-08-19",
  "main": "./worker/cron.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "product-finder-platform",
      "database_id": "b00ff1c8-eb5a-49ba-ba18-446b3437f907",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    // UTC 03:00 = JST 12:00 (noon)。日本時間の昼前にカタログを更新する。
    // Cloudflare Cron Triggers は UTC 基準。DST の影響を受けない日本時間前提。
    // 時刻変更時は Production trigger 変更としてコード変更と分離して扱う。
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
